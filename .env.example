# Copie para .env e preencha. NUNCA commite o .env.

# Segredo JWT (obrigatório em produção). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Origens permitidas no CORS, separadas por vírgula. Vazio = apenas mesma origem.
CORS_ORIGINS=

# Host de bind do servidor local (no Docker o comando já usa 0.0.0.0)
CORTEX_HOST=127.0.0.1

# IA / Gemini
GEMINI_API_KEY=

# Token esperado no webhook de pagamentos
PAYMENT_WEBHOOK_TOKEN=

# Ambiente
ENVIRONMENT=production

# Asaas (cobranças)
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=

# Banco de dados. Vazio = SQLite local (data/cortex_erp.db). Para PostgreSQL:
#   DATABASE_URL=postgresql://cortex:SENHA@db:5432/cortex
DATABASE_URL=

# Senha do PostgreSQL do docker-compose (perfil "postgres")
POSTGRES_PASSWORD=

# HTTPS / Proxy Reverso Caddy (perfil "proxy")
DOMAIN=localhost
ACME_EMAIL=admin@cortex.com.br

# Nuvem Fiscal (emissor fiscal — plano gratuito disponível em https://nuvemfiscal.com.br)
# No cadastro da empresa: Motor Fiscal = "nuvem_fiscal", Token = CLIENT_ID|CLIENT_SECRET
# Exemplo: NUVEM_FISCAL_TOKEN=abc123clientid|xyzSecretKey456
NUVEM_FISCAL_CLIENT_ID=
NUVEM_FISCAL_CLIENT_SECRET=
# Focus NFe (alternativa — sem plano gratuito, https://focusnfe.com.br)
FOCUSNFE_TOKEN=

# E-mail para recuperação de senha (SMTP).
# Deixe SMTP_HOST vazio para modo dev: o link de reset é retornado na resposta da API.
# Em produção configure um servidor SMTP ou serviço transacional (SendGrid, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cortex.com.br

# URL pública do sistema (usado no link de recuperação de senha enviado por e-mail).
# Exemplo: https://erp.minhaempresa.com.br
APP_BASE_URL=

# Observabilidade, Limite de Requisições e Logs
# Rate Limiting por IP (0 desativa)
RATE_LIMIT_API=300
RATE_LIMIT_LOGIN=10
# Confiar no header X-Forwarded-For vindo de proxy reverso (1 ativa, 0 desativa)
TRUSTED_PROXY=0
# Token Bearer para proteger endpoint /metrics do Prometheus (opcional)
METRICS_TOKEN=
# Nível e formato de logs: text ou json
LOG_LEVEL=INFO
LOG_FORMAT=text
